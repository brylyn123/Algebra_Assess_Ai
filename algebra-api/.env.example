# --- Database (Railway MySQL plugin sets these automatically; map them in the dashboard) ---
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=algebra_learning_system
DB_PORT=3306

# --- AI grading (DeepSeek + Gemini OCR) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_OCR_MODEL=deepseek-flash
DEEPSEEK_OCR_PROVIDER=gemini
DEEPSEEK_TIMEOUT_SECONDS=60
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Email (OTP / password reset) — optional but recommended ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=AlgebraAssess
